# nginx untuk SIMRS Face Recognition (TLS wajib: browser hanya mengizinkan kamera USB di HTTPS).
# Template: image nginx resmi mengganti ${FACE_HTTPS_PORT} via envsubst saat start.

server {
    listen 80;
    server_name _;
    return 301 https://$host:${FACE_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    # Izinkan kamera hanya untuk origin aplikasi ini.
    add_header Permissions-Policy "camera=(self), microphone=()" always;

    # Frame kamera USB maks ~1 MB; foto registrasi maks 5 MB.
    client_max_body_size 8m;

    # DNS internal Docker; proxy_pass bervariabel agar IP container dicari ulang setelah rebuild
    # (pola yang sama dengan casemixiDRG).
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /static/ {
        root /;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
    }

    # Tidak ada location untuk media_private: foto biometrik hanya keluar lewat Django (wajib login).

    # Frame kamera USB -> container vision (satu proses pemegang state tracker).
    location /api/face/v1/stations/ {
        set $upstream_vision http://vision:8001;
        proxy_pass $upstream_vision;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    # Stream MJPEG kamera server (worker RTSP) — jangan di-buffer.
    location = /stream/ {
        set $upstream_web http://web:8000;
        proxy_pass $upstream_web;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location / {
        set $upstream_web http://web:8000;
        proxy_pass $upstream_web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 30s;
        proxy_read_timeout 120s;
    }
}

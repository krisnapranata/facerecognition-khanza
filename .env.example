# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env.
# scripts/setup_ubuntu.sh membuat .env otomatis dan meng-generate secret.

APP_MODE=demo                      # demo | production
DJANGO_SECRET_KEY=                 # generate: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=true                  # wajib false pada production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Jakarta

# --- MySQL/MariaDB customsik (hanya tabel face_* yang dibuat) ---
DB_NAME=customsik
DB_USER=sik
DB_PASSWORD=                       # isi di .env lokal; jangan ditulis di source code/script
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Kunci & secret biometrik ---
# Kunci Fernet, dipisah koma; kunci pertama untuk enkripsi (rotasi: manage.py face_rotate_keys)
# generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FACE_EMBEDDING_KEYS=
# Secret HMAC antarlayanan AI worker <-> Django
FACE_WORKER_SECRET=

# --- Model AI (OpenCV Zoo; lihat docs/MODELS.md) ---
FACE_DETECTOR_MODEL=models/face_detection_yunet_2023mar.onnx
FACE_EMBEDDING_MODEL=models/face_recognition_sface_2021dec.onnx
FACE_EMBEDDING_BACKEND=onnxruntime     # onnxruntime | opencv

# --- Ambang pencocokan (nilai AWAL, wajib divalidasi dengan data lokal) ---
FACE_MATCH_THRESHOLD=0.50
FACE_REVIEW_THRESHOLD=0.363
FACE_MATCH_MARGIN=0.08
FACE_RETENTION_DAYS=90
FACE_MIN_FACE_SIZE=64
FACE_REGISTRATION_MIN_FACE_SIZE=80

# --- Kamera & AI worker ---
CAMERA_SOURCE=0                    # index webcam, atau rtsp://user:pass@ip:554/stream (tidak dikirim ke browser)
CAMERA_ID=laptop-0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
FACE_DJANGO_URL=http://127.0.0.1:8020
FACE_WORKER_URL=http://127.0.0.1:8765
WORKER_HTTP_HOST=127.0.0.1
WORKER_HTTP_PORT=8765
WORKER_MAX_INFERENCE_FPS=10
WORKER_MATCH_INTERVAL_SECONDS=2

# --- Integrasi Khanza (NONAKTIF pada demo; baca-saja) ---
KHANZA_ENABLED=false
KHANZA_SCHEMA_VERIFIED=false
KHANZA_QUERY_FILE=config/khanza_queries.json   # relatif terhadap folder proyek
KHANZA_DB_NAME=
KHANZA_DB_USER=                    # WAJIB user baca-saja (SELECT saja)
KHANZA_DB_PASSWORD=
KHANZA_DB_HOST=127.0.0.1
KHANZA_DB_PORT=3306

# --- Registrasi kunjungan ke reg_periksa & login akun tabel `user` Khanza (lihat docs/KHANZA_INTEGRATION.md) ---
KHANZA_REGISTRATION_ENABLED=false
KHANZA_AUTH_ENABLED=false
KHANZA_RW_DB_USER=                 # akun MySQL untuk INSERT reg_periksa (aplikasi membatasi SQL tulis di kode)
KHANZA_RW_DB_PASSWORD=
KHANZA_BASENOREG=booking           # samakan dengan setting/database.xml Khanza
KHANZA_URUTNOREG=dokter + poli     # poli | dokter | dokter + poli
KHANZA_EXCLUDED_POLI=IGDK
KHANZA_JADWAL_MODE=hari_ini        # hari_ini: hanya dokter praktik hari ini (cek kuota) | semua: semua dokter di tabel jadwal

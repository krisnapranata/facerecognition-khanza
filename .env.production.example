# ======================================================================
# Konfigurasi PRODUKSI (server A, Docker). Salin ke .env.production lalu isi.
#   cp .env.production.example .env.production && chmod 600 .env.production
# Database customsik & Khanza berada di server B (satu jaringan LAN). IP di bawah hanya CONTOH.
# ======================================================================

APP_MODE=production
DJANGO_DEBUG=false
# generate: python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# IP/nama server A yang dibuka PC loket + "web" (nama container, dipakai AI worker RTSP)
DJANGO_ALLOWED_HOSTS=192.168.1.20,facerec.rs.local,web,localhost
# Origin HTTPS lengkap dengan port nginx (FACE_HTTPS_PORT)
CSRF_TRUSTED_ORIGINS=https://192.168.1.20:8443,https://facerec.rs.local:8443
BEHIND_TLS_PROXY=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
TIME_ZONE=Asia/Makassar
LOG_LEVEL=INFO

# Port yang dipublikasikan nginx di server A (mode mandiri). Di server yang sudah memakai
# Nginx Proxy Manager (80/443) pakai docker-compose.npm.yml: port ini tidak dipakai.
FACE_HTTPS_PORT=8443
FACE_HTTP_PORT=8088
# Nama jaringan Docker milik Nginx Proxy Manager (mode NPM):
#   docker inspect proxy-npm-1 --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
NPM_NETWORK=proxy_default
# Hanya bila database ada di container MySQL casemixiDRG (docker-compose.casemixdb.yml); DB_HOST=db
CASEMIX_NETWORK=casemixidrg_default

# --- Database customsik di server B (hanya tabel face_*) ---
DB_NAME=customsik
DB_USER=sik
DB_PASSWORD=
DB_HOST=192.168.10.20
DB_PORT=3306

# --- Kunci biometrik: SALIN dari server lama bila memindahkan data; cadangkan terpisah! ---
# generate: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FACE_EMBEDDING_KEYS=
# generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
FACE_WORKER_SECRET=

# --- Model AI (sudah ikut di image dari folder models/) ---
FACE_DETECTOR_MODEL=models/face_detection_yunet_2023mar.onnx
FACE_EMBEDDING_MODEL=models/face_recognition_sface_2021dec.onnx
FACE_EMBEDDING_BACKEND=onnxruntime

FACE_MATCH_THRESHOLD=0.50
FACE_REVIEW_THRESHOLD=0.363
FACE_MATCH_MARGIN=0.08
FACE_RETENTION_DAYS=90

# --- Kamera ---
# usb    : dashboard default memakai kamera USB di PC loket (browser -> container vision)
# server : kamera yang dibaca AI worker (IP camera RTSP, profile "rtsp")
FACE_DEFAULT_CAMERA=usb
FACE_STATION_MAX_FPS=4
VISION_THREADS=8
VISION_CPUS=4
GUNICORN_WORKERS=3

# Hanya untuk profile "rtsp" (IP camera pintu masuk). URL/password RTSP tidak pernah dikirim ke browser.
CAMERA_SOURCE=rtsp://user:password@192.168.1.50:554/stream1
CAMERA_ID=pintu-masuk
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# --- Khanza di server B ---
KHANZA_ENABLED=true
KHANZA_SCHEMA_VERIFIED=true
KHANZA_QUERY_FILE=config/khanza_queries.json
KHANZA_DB_NAME=yatofaasli
# User baca-saja; buat dengan host = IP server A (lihat docs/DEPLOY_PRODUCTION.md)
KHANZA_DB_USER=face_ro
# Bila memakai akun Khanza yang sudah ada (mis. sik, berhak tulis) untuk membaca data pasien, set true.
# Koneksi baca tetap dikunci READ ONLY per sesi dan hanya menjalankan SELECT dari config/khanza_queries.json.
KHANZA_ALLOW_PRIVILEGED_USER=false
KHANZA_DB_PASSWORD=
KHANZA_DB_HOST=192.168.10.20
KHANZA_DB_PORT=3306

# Registrasi kunjungan reg_periksa & login akun tabel `user` Khanza
KHANZA_REGISTRATION_ENABLED=true
KHANZA_AUTH_ENABLED=true
KHANZA_RW_DB_USER=sik
KHANZA_RW_DB_PASSWORD=
KHANZA_BASENOREG=booking
KHANZA_URUTNOREG=dokter + poli
KHANZA_EXCLUDED_POLI=IGDK
KHANZA_JADWAL_MODE=hari_ini
